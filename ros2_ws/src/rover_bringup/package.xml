<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and configuration for the MichaelAI rover.</description>
  <maintainer email="easaunchen789@gmail.com">EasChen70</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch-only package: nothing is compiled, so these are needed at runtime only.
       nav2_bringup provides tb3_simulation_launch.py and pulls in the TurtleBot sim. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>

  <!-- Only for the opt-in test/test_sim_baseline.launch.py; listed so rosdep installs them.
       tf2_ros_py provides the Python tf2_ros module. -->
  <test_depend>launch_testing</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>tf2_ros_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
